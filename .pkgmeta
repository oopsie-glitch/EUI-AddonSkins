# Promote the core and each load-on-demand module to sibling install folders.
package-as: EUIAddonSkins

enable-nolib-creation: no

required-dependencies:
  - ellesmereui

move-folders:
  EUIAddonSkins/EUIAddonSkins: EUIAddonSkins
  EUIAddonSkins/EUIAddonSkins_Altoholic: EUIAddonSkins_Altoholic
  EUIAddonSkins/EUIAddonSkins_AtlasLootContinued: EUIAddonSkins_AtlasLootContinued
  EUIAddonSkins/EUIAddonSkins_Attune: EUIAddonSkins_Attune
  EUIAddonSkins/EUIAddonSkins_Auctionator: EUIAddonSkins_Auctionator
  EUIAddonSkins/EUIAddonSkins_BugSack: EUIAddonSkins_BugSack
  EUIAddonSkins/EUIAddonSkins_DBM: EUIAddonSkins_DBM
  EUIAddonSkins/EUIAddonSkins_Details: EUIAddonSkins_Details
  EUIAddonSkins/EUIAddonSkins_ForeverCompanion: EUIAddonSkins_ForeverCompanion
  EUIAddonSkins/EUIAddonSkins_ForeverDungeonJournal: EUIAddonSkins_ForeverDungeonJournal
  EUIAddonSkins/EUIAddonSkins_GTFO: EUIAddonSkins_GTFO
  EUIAddonSkins/EUIAddonSkins_Gargul: EUIAddonSkins_Gargul
  EUIAddonSkins/EUIAddonSkins_ItemRack: EUIAddonSkins_ItemRack
  EUIAddonSkins/EUIAddonSkins_KiwiFarm: EUIAddonSkins_KiwiFarm
  EUIAddonSkins/EUIAddonSkins_Myslot: EUIAddonSkins_Myslot
  EUIAddonSkins/EUIAddonSkins_Questie: EUIAddonSkins_Questie
  EUIAddonSkins/EUIAddonSkins_RXPGuides: EUIAddonSkins_RXPGuides
  EUIAddonSkins/EUIAddonSkins_Spy: EUIAddonSkins_Spy
  EUIAddonSkins/EUIAddonSkins_ThreatClassic2: EUIAddonSkins_ThreatClassic2
  EUIAddonSkins/EUIAddonSkins_TwitchEmotes: EUIAddonSkins_TwitchEmotes
  EUIAddonSkins/EUIAddonSkins_WhatsTraining: EUIAddonSkins_WhatsTraining

# Paths here are relative to the repository, before folder moves.
ignore:
  - .github
  - benchmarks
  - tests
  - scripts
  - docs
  - README.md
  - CHANGELOG.md
  - CURSEFORGE.md
  - LICENSE
  - EUIAddonSkins/README.md
  - EUIAddonSkins/CHANGELOG.md
  - audit
  - source
  - reference
  - upload
  - helpers
  - dist
  - build
  - EUIAddonSkins.zip
  - EUIAddonSkins-1.0.0.zip

# Read from the checkout for the CurseForge file page, not from the ZIP.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# LICENSE is already tracked inside the addon; do not generate a replacement.
# No externals: EllesmereUI and all supported addons are installed separately.
